      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning",
      "Hangfire": "Warning"
    }
  },
  
    "JWT__SECRET": "NTk5ODE2MDQtNWJjNS00OGU3LTk3OTgtZTI4OTdkZDFjNDI0N2I3ZTEzZGEtMGRjNi00MTE2LWJmOGItMzY3YzMwOWUxODc5",
  
  "AllowedHosts": "*",
  "ConnectionStrings": {
