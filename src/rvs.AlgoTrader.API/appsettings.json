      "ApiKey": "your-upstox-api-key",
      "ApiSecret": "your-upstox-api-secret",
      "RedirectUri": "http://localhost:5000/api/broker/upstox/callback"
    },
    "MStock": {
      "BaseUrl": "https://api.mstock.trade/openapi/typeb",
      "WebSocketUrl": "wss://api.mstock.trade/openapi/typeb/feed",
