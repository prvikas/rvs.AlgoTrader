  "Broker": {
    "ActiveBroker": "MStock",
    "Zerodha": {
      "BaseUrl": "https://api.kite.trade",
      "WebSocketUrl": "wss://ws.kite.trade"
    },
    "Upstox": {
      "BaseUrl": "https://api.upstox.com/v2",
