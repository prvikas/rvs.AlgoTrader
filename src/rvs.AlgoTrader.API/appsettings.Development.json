{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "MassTransit": "Information",
      "Hangfire": "Information",
      "rvs.AlgoTrader": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=algotrader_dev;Username=postgres;Password=postgres;Include Error Detail=true",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "RabbitMQ": {
    "Enabled": false,
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Issuer": "rvs.AlgoTrader.Dev",
    "Audience": "rvs.AlgoTrader.Client",
    "Key": "dev-secret-key-do-not-use-in-production-32chars",
    "ExpiryHours": 24
  },
  "Vault": {
    "Enabled": false
  },
  "Broker": {
    "ActiveBroker": "MStock",
    "Zerodha": {
      "BaseUrl": "https://api.kite.trade",
      "WebSocketUrl": "wss://ws.kite.trade"
    },
    "Upstox": {
      "BaseUrl": "https://api.upstox.com/v2",
      "WebSocketUrl": "wss://api.upstox.com/v3/feed/market-data-streamer",
      "ApiKey": "DEV_API_KEY",
      "ApiSecret": "DEV_API_SECRET",
      "RedirectUri": "http://localhost:5000/api/broker/upstox/callback"
    },
    "MStock": {
      "BaseUrl": "https://api.mstock.trade/openapi/typeb",
      "WebSocketUrl": "wss://api.mstock.trade/openapi/typeb/feed",
      "ApiKey": "DEV_API_KEY",
      "PrivateKey": "DEV_PRIVATE_KEY",
      "ClientCode": "DEV_CLIENT_CODE",
      "Password": "DEV_PASSWORD"
    }
  },
  "Hangfire": {
    "Dashboard": {
      "Username": "admin",
      "Password": "admin"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  }
}
