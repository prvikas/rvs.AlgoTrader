# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=algotrader
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Vault (dev mode)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-64-chars
JWT_ISSUER=rvs.AlgoTrader
JWT_AUDIENCE=rvs.AlgoTrader.Client
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# Broker credentials (use Vault in production)
BROKERS__ZERODHA__APIKEY=
BROKERS__ZERODHA__APISECRET=
BROKERS__ZERODHA__BASEURL=https://api.kite.trade
BROKERS__ZERODHA__WSURL=wss://ws.kite.trade

BROKERS__UPSTOX__CLIENTID=
BROKERS__UPSTOX__CLIENTSECRET=
BROKERS__UPSTOX__BASEURL=https://api.upstox.com/v2
BROKERS__UPSTOX__WSURL=wss://api.upstox.com/v3/feed/market-data-feed

BROKERS__MSTOCK__APIKEY=
BROKERS__MSTOCK__PRIVATEKEY=
BROKERS__MSTOCK__BASEURL=https://api.mstock.trade
BROKERS__MSTOCK__WSURL=wss://api.mstock.trade

# Notifications
TELEGRAM__BOTTOKEN=
TELEGRAM__CHATID=
SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USER=
SMTP__PASSWORD=
SMTP__FROM=noreply@algotrader.local

# Secrets provider: vault | environment
SECRETS__PROVIDER=environment
